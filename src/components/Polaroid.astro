---
import { withBase } from '~/lib/paths';

interface Props {
  src?: string;
  alt?: string;
  color?: string;
  icon?: string;
  caption: string;
  sub?: string;
  tilt?: number;
  href?: string;
  tape?: boolean;
}
const { src, alt = '', color, icon, caption, sub, tilt = 1, href, tape = false } = Astro.props;
const tiltClamp = ((tilt % 6) + 6) % 6 + 1;
const imgSrc = src ? withBase(src) : undefined;
const linkHref = href ? withBase(href) : undefined;
---

{
  href ? (
    <a class="polaroid" href={linkHref} data-tilt={tiltClamp}>
      {tape && <span class="tape" data-pos="top-center"></span>}
      <div class="polaroid-photo">
        {imgSrc
          ? <img src={imgSrc} alt={alt} loading="lazy" decoding="async" />
          : color
            ? <div class="pastel" style={`background-color: ${color};`}>{icon && <img class="pastel-icon" src={withBase(icon)} alt="" loading="lazy" />}</div>
            : <div class="placeholder"><span>your photo</span><span>goes here</span></div>}
      </div>
      <div class="polaroid-caption">{caption}{sub && <small>{sub}</small>}</div>
    </a>
  ) : (
    <div class="polaroid" data-tilt={tiltClamp}>
      {tape && <span class="tape" data-pos="top-center"></span>}
      <div class="polaroid-photo">
        {imgSrc
          ? <img src={imgSrc} alt={alt} loading="lazy" decoding="async" />
          : color
            ? <div class="pastel" style={`background-color: ${color};`}>{icon && <img class="pastel-icon" src={withBase(icon)} alt="" loading="lazy" />}</div>
            : <div class="placeholder"><span>your photo</span><span>goes here</span></div>}
      </div>
      <div class="polaroid-caption">{caption}{sub && <small>{sub}</small>}</div>
    </div>
  )
}
