---
interface Props {
  name: 'cat' | 'computer' | 'flower' | 'disk' | 'cat2' | 'flower2';
}
const { name } = Astro.props;
---

{
  name === 'cat' && (
    <svg class="sticker-svg" viewBox="0 0 100 100" role="img" aria-label="cat sticker">
      <path d="M28 46 L18 12 L52 32 Z" fill="#F0B7C4" />
      <path d="M72 46 L82 12 L48 32 Z" fill="#F0B7C4" />
      <circle cx="50" cy="58" r="34" fill="#F0B7C4" />
      <circle cx="50" cy="46" r="20" fill="#FBDCE3" />
      <circle cx="40" cy="56" r="4.5" fill="#4A3B34" />
      <circle cx="60" cy="56" r="4.5" fill="#4A3B34" />
      <circle cx="42" cy="54" r="1.5" fill="#fff" />
      <circle cx="62" cy="54" r="1.5" fill="#fff" />
      <path d="M40 70 Q50 77 60 70" stroke="#4A3B34" stroke-width="3" fill="none" stroke-linecap="round" />
      <path d="M50 66 L50 73 M46 68 L44 72 M54 68 L56 72" stroke="#4A3B34" stroke-width="2.5" fill="none" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'cat2' && (
    <svg class="sticker-svg" viewBox="0 0 100 100" role="img" aria-label="black cat sticker">
      <path d="M28 44 L16 10 L54 30 Z" fill="#3A3430" />
      <path d="M72 44 L84 10 L46 30 Z" fill="#3A3430" />
      <circle cx="50" cy="56" r="34" fill="#3A3430" />
      <circle cx="50" cy="44" r="20" fill="#57504B" />
      <circle cx="40" cy="54" r="5" fill="#F7C873" />
      <circle cx="60" cy="54" r="5" fill="#F7C873" />
      <circle cx="42" cy="52" r="1.8" fill="#1B1714" />
      <circle cx="62" cy="52" r="1.8" fill="#1B1714" />
      <path d="M41 70 Q50 76 59 70" stroke="#F0E9E0" stroke-width="3" fill="none" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'computer' && (
    <svg class="sticker-svg" viewBox="0 0 100 100" role="img" aria-label="computer sticker">
      <rect x="14" y="14" width="72" height="50" rx="6" fill="#E8E2D6" stroke="#4A3B34" stroke-width="4" />
      <rect x="22" y="22" width="56" height="30" rx="2" fill="#BFD8D8" />
      <path d="M50 64 L50 76 M36 76 L64 76" stroke="#4A3B34" stroke-width="5" fill="none" stroke-linecap="round" />
      <rect x="40" y="78" width="20" height="8" rx="3" fill="#F0B7C4" />
      <circle cx="36" cy="35" r="3" fill="#4A3B34" />
      <path d="M34 42 L28 48 M32 50 L38 44" stroke="#4A3B34" stroke-width="3" fill="none" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'flower' && (
    <svg class="sticker-svg" viewBox="0 0 100 100" role="img" aria-label="flower sticker">
      <path d="M50 62 Q38 74 50 88 Q62 74 50 62" fill="#7BA05B" />
      <path d="M46 66 L44 44 M54 66 L56 44" stroke="#7BA05B" stroke-width="4" fill="none" stroke-linecap="round" />
      <circle cx="34" cy="40" r="13" fill="#F2A8B5" />
      <circle cx="50" cy="30" r="13" fill="#F7C873" />
      <circle cx="66" cy="40" r="13" fill="#F2A8B5" />
      <circle cx="34" cy="58" r="13" fill="#F7C873" />
      <circle cx="66" cy="58" r="13" fill="#F2A8B5" />
      <circle cx="50" cy="48" r="12" fill="#FBDCE3" stroke="#F2A8B5" stroke-width="2" />
      <circle cx="50" cy="48" r="5" fill="#F7C873" />
    </svg>
  )
}
{
  name === 'flower2' && (
    <svg class="sticker-svg" viewBox="0 0 100 100" role="img" aria-label="tiny flower sticker">
      <circle cx="30" cy="52" r="12" fill="#BfD8D8" />
      <circle cx="50" cy="42" r="12" fill="#BfD8D8" />
      <circle cx="70" cy="52" r="12" fill="#BfD8D8" />
      <circle cx="50" cy="50" r="11" fill="#F0B7C4" />
      <circle cx="50" cy="50" r="5" fill="#F7C873" />
      <path d="M50 60 L50 78" stroke="#7BA05B" stroke-width="5" fill="none" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'disk' && (
    <svg class="sticker-svg" viewBox="0 0 100 100" role="img" aria-label="floppy disk sticker">
      <rect x="16" y="12" width="68" height="76" rx="8" fill="#C7C2B6" stroke="#4A3B34" stroke-width="4" />
      <rect x="16" y="12" width="68" height="34" rx="8" fill="#F0B7C4" />
      <rect x="24" y="20" width="40" height="16" rx="3" fill="#FBDCE3" />
      <rect x="56" y="58" width="20" height="20" rx="4" fill="#BFD8D8" stroke="#4A3B34" stroke-width="3" />
    </svg>
  )
}

<style>
  .sticker-svg {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 2px 2px rgba(45, 42, 38, 0.2));
  }
</style>
