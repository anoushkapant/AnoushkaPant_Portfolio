---
const label = 'Switch to dark mode';
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label={label}
  aria-pressed="false"
  title={label}
>
  <svg class="icon icon-moon" viewBox="0 0 24 24" role="img" aria-hidden="true">
    <path
      d="M20.5 14.3A8.5 8.5 0 0 1 9.7 3.5a8.5 8.5 0 1 0 10.8 10.8Z"
      fill="currentColor"
    />
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 24 24" role="img" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="currentColor" />
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22" />
      <path d="M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7" />
    </g>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function sync() {
    const isDark = root.dataset.theme === 'dark';
    buttons.forEach((btn) => {
      const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
      btn.setAttribute('aria-pressed', String(isDark));
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    });
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('scrapbook:theme', next);
      } catch {
        /* storage unavailable — theme still applies for this page */
      }
      sync();
    });
  });

  sync();
</script>
