---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths';
---

<Base
  title="Contact — Anoushka"
  description="Get in touch with Anoushka."
>
  <section class="page-intro">
    <h1>let's make something</h1>
    <p>
      Commissions, collaborations, or just to say hi —
      all the good words are below.
    </p>
  </section>

  <ul class="contact-options">
    <li><a href="mailto:hello@example.com">✉️ hello@example.com</a></li>
    <li><a href="https://github.com/yourusername" target="_blank" rel="noopener">⟨⟩ github</a></li>
    <li><a href="https://instagram.com/yourusername" target="_blank" rel="noopener">📷 instagram</a></li>
    <li><a href="https://linkedin.com/in/yourusername" target="_blank" rel="noopener">💼 linkedin</a></li>
    <li><a href={withBase('/uploads/pdfs/resume.pdf')} download>📄 resume (pdf)</a></li>
  </ul>

  <p style="font-family: var(--font-caption); font-size: 1.3rem; color: var(--ink-soft); margin-top: 2.4rem;">
    Drop your resume into <code>public/uploads/pdfs/</code> to make the download work —
    or just point the link above at your own.
  </p>
</Base>
