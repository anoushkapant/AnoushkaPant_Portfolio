---
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import Polaroid from '../components/Polaroid.astro';
import PdfStamp from '../components/PdfStamp.astro';
import { withBase } from '../lib/paths';
import { getFeatured, getNonFeatured, formatDate } from '../lib/entries';

const featured = await getFeatured();
const rest = await getNonFeatured();

const heroStickers = [
  { src: '/uploads/stickers/sticker1-cat.png', corner: true, style: { top: '-10px', left: '-8px', width: '90px', transform: 'rotate(-10deg)' } },
  { src: '/uploads/stickers/sticker2-cat.png', corner: true, style: { top: '-12px', right: '2%', width: '80px', transform: 'rotate(8deg)' } },
  { src: '/uploads/stickers/sticker3-flower.png', mid: true, style: { bottom: '24%', left: '-10px', width: '76px', transform: 'rotate(-6deg)' } },
  { src: '/uploads/stickers/sticker4-star.png', mid: true, style: { top: '44%', left: '-6px', width: '62px', transform: 'rotate(12deg)' } },
  { src: '/uploads/stickers/sticker5-catbread.png', corner: true, style: { bottom: '-10px', right: '14%', width: '82px', transform: 'rotate(4deg)' } },
  { src: '/uploads/stickers/sticker6-flower-pink.png', mid: true, style: { bottom: '46%', right: '-10px', width: '58px', transform: 'rotate(-9deg)' } },
  { src: '/uploads/stickers/sticker7-star-button.png', mid: true, style: { top: '4%', left: '17%', width: '54px', transform: 'rotate(16deg)' } },
  { src: '/uploads/stickers/sticker8-strawberry.png', mid: true, style: { bottom: '5%', left: '21%', width: '56px', transform: 'rotate(-14deg)' } },
];
---

<Base
  title="Anoushka — Portfolio"
  description="Anoushka — a Computer Science student at the Hong Kong Polytechnic University."
  typewriter
>
  <section class="hero">
    <div class="scatter" aria-hidden="true">
      {heroStickers.map((s) => (
        <span
          class="s"
          data-corner={s.corner ? '' : undefined}
          data-mid={s.mid ? '' : undefined}
          style={s.style}
        >
          <img src={withBase(s.src)} alt="" />
        </span>
      ))}
    </div>

    <div class="hero-text">
      <h1>Hi I am <span>Anoushka</span></h1>
      <p>
        a Computer Science student at the Hong Kong Polytechnic University —
        making zines and software, one scrapbook page at a time.
      </p>
      <p class="hero-note">
        scroll for the work ↓
      </p>
    </div>

    <div class="hero-sticker">
      <span class="tape" data-pos="top-center"></span>
      <div class="hero-photo">
        <div class="hero-photo-fallback">your photo ✶</div>
        <img
          src={withBase('/uploads/photos/portrait.jpg')}
          alt="Anoushka"
          loading="lazy"
          onerror="this.remove()"
        />
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="featured-section">
        <div class="featured-label">★ featured work ★</div>
        <div class="featured-card">
          <Polaroid
            src={featured.data.images[0]}
            alt={featured.data.summary}
            caption={featured.data.title}
            sub={formatDate(featured.data.date)}
            tilt={1}
            tape
            href={`/projects/${featured.id}`}
          />
        </div>
      </section>
    )
  }

  <FilterBar />

  <section class="project-grid" aria-label="Projects">
    {
      rest.map((project, i) => {
        const hasPdf = project.data.pdfs.length > 0;
        return (
          <div class="project-card" data-project-type={project.data.type}>
            <Polaroid
              src={project.data.images[0]}
              alt={project.data.summary}
              caption={project.data.title}
              sub={formatDate(project.data.date)}
              tilt={i % 6}
              href={`/projects/${project.id}`}
              tape={i % 3 === 0}
            />
            {hasPdf && (
              <div style="text-align:center; margin-top:-0.6rem;">
                <PdfStamp url={project.data.pdfs[0]} />
              </div>
            )}
          </div>
        );
      })
    }
  </section>

  <section class="fun-hero" style="margin-top: 1rem;">
    <p>
      psst — the <a href={withBase('/fun')} style="font-family: var(--font-caption); font-size: 1.35rem;">sticker wall</a> is open. leave a sticker on your way out.
    </p>
  </section>
</Base>
