---
import Base from '../layouts/Base.astro';
import FilterBar from '../components/FilterBar.astro';
import Polaroid from '../components/Polaroid.astro';
import PdfStamp from '../components/PdfStamp.astro';
import Tape from '../components/Tape.astro';
import { withBase } from '../lib/paths';
import { getFeatured, getNonFeatured } from '../lib/entries';

const featured = await getFeatured();
const rest = await getNonFeatured();

const pastel = ['#f9d5d3', '#d9e8d5', '#f7e6c4', '#d5e4f0', '#ecd9e8', '#d5ecec', '#f2dcd1'];

const leftCol = [
  '/uploads/stickers/sticker1-cat.png',
  '/uploads/stickers/sticker3-flower.png',
  '/uploads/stickers/sticker8-strawberry.png',
  '/uploads/stickers/sticker5-catbread.png',
  '/uploads/stickers/sticker4-star.png',
  '/uploads/stickers/sticker6-flower-pink.png',
  '/uploads/stickers/sticker2-cat.png',
  '/uploads/stickers/sticker7-star-button.png',
  '/uploads/stickers/sticker5-catbread.png',
  '/uploads/stickers/sticker8-strawberry.png',
  '/uploads/stickers/sticker1-cat.png',
  '/uploads/stickers/sticker3-flower.png',
];

const rightCol = [
  '/uploads/stickers/sticker4-star.png',
  '/uploads/stickers/sticker2-cat.png',
  '/uploads/stickers/sticker7-star-button.png',
  '/uploads/stickers/sticker6-flower-pink.png',
  '/uploads/stickers/sticker5-catbread.png',
  '/uploads/stickers/sticker1-cat.png',
  '/uploads/stickers/sticker8-strawberry.png',
  '/uploads/stickers/sticker3-flower.png',
  '/uploads/stickers/sticker7-star-button.png',
  '/uploads/stickers/sticker6-flower-pink.png',
  '/uploads/stickers/sticker2-cat.png',
  '/uploads/stickers/sticker4-star.png',
];

const pastelIcons = [
  '/uploads/stickers/sticker1-cat.png',
  '/uploads/stickers/sticker2-cat.png',
  '/uploads/stickers/sticker3-flower.png',
  '/uploads/stickers/sticker4-star.png',
  '/uploads/stickers/sticker5-catbread.png',
  '/uploads/stickers/sticker7-star-button.png',
  '/uploads/stickers/sticker8-strawberry.png',
];
let iconIndex = 0;
---

<Base
  title="Anoushka — Portfolio"
  description="Anoushka — a Computer Science student at the Hong Kong Polytechnic University."
  typewriter
  home
>
  <div class="home-top">
    <Tape position="page-top-left" />
    <Tape position="page-top-right" />
    <div class="sticker-border" aria-hidden="true">
      <div class="sticker-col col-left">
        {leftCol.map((src) => (
          <img src={withBase(src)} alt="" loading="lazy" />
        ))}
      </div>
      <div class="sticker-col col-right">
        {rightCol.map((src) => (
          <img src={withBase(src)} alt="" loading="lazy" />
        ))}
      </div>
    </div>

    <section class="hero">
    <div class="hero-text">
      <h1>Hi I am <span>Anoushka</span></h1>
      <p>
        a Computer Science student at the Hong Kong Polytechnic University<br />
        just a potato who like to draw and code
      </p>
      <p class="hero-note">
        <a href={withBase('/#work')}>scroll to see my projects ↓</a>
      </p>
    </div>

    <div class="hero-sticker">
      <span class="tape" data-pos="top-center"></span>
      <div class="hero-photo">
        <div class="hero-photo-fallback">your photo ✶</div>
        <img
          src={withBase('/uploads/photos/portrait.jpg')}
          alt="Anoushka"
          loading="lazy"
          onerror="this.remove()"
        />
      </div>
    </div>
  </section>

  {
    featured && (
      <section class="featured-section">
        <div class="featured-label">★ featured work ★</div>
        <div class="featured-card">
          <Polaroid
            src={featured.data.images[0]}
            alt={featured.data.summary}
            caption={featured.data.title}
            tilt={1}
            tape
            href={`/projects/${featured.id}`}
          />
        </div>
      </section>
    )
  }
  </div>

  <div class="projects-divider" aria-hidden="true"></div>
  <h2 class="section-heading" id="work" style="margin-top: 0;">projects</h2>
  <FilterBar />

  <section class="project-grid" aria-label="Projects">
    {
      rest.map((project, i) => {
        const hasPdf = project.data.pdfs.length > 0;
        const technical = project.data.type === 'technical';
        const icon = technical ? pastelIcons[iconIndex++ % pastelIcons.length] : undefined;
        return (
          <div class="project-card" data-project-type={project.data.type}>
            <Polaroid
              src={project.data.images[0]}
              color={pastel[i % pastel.length]}
              icon={icon}
              alt={project.data.summary}
              caption={project.data.title}
              sub={undefined}
              tilt={i % 6}
              href={`/projects/${project.id}`}
              tape={i % 3 === 0}
            />
            {hasPdf && (
              <div style="text-align:center; margin-top:-0.6rem;">
                <PdfStamp url={project.data.pdfs[0]} />
              </div>
            )}
          </div>
        );
      })
    }
  </section>

  <section class="fun-hero" style="margin-top: 1rem;">
    <p>
      psst — the <a href={withBase('/fun')} style="font-family: var(--font-caption); font-size: 1.35rem;">sticker wall</a> is open. leave a sticker on your way out.
    </p>
  </section>
</Base>
