---
import Base from '../layouts/Base.astro';
import StickerWall from '../components/StickerWall.astro';
---

<Base
  title="The Sticker Wall — Anoushka"
  description="A shared sticker wall. Leave something on your way out."
>
  <section class="fun-hero">
    <h1>the sticker wall 🌷</h1>
    <p>
      Everyone who visits can stick something to the wall, and it stays there.
      Grab a sticker, drag it somewhere, and it's yours until someone moves it.
    </p>
  </section>

  <StickerWall />
</Base>
