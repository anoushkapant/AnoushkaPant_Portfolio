---
import Base from '../layouts/Base.astro';
import Polaroid from '../components/Polaroid.astro';
import { withBase } from '../lib/paths';
---

<Base
  title="About — Anoushka"
  description="About Anoushka Pant — a Computer Science student at the Hong Kong Polytechnic University."
  typewriter
>
  <section class="page-intro">
    <h1>about me</h1>
    <p>just a potato who like to draw and code</p>
    <nav class="page-links" aria-label="On this page">
      <a href="#education">education</a>
      <a href="#skills">skills</a>
      <a href="#experience">experience</a>
    </nav>
  </section>

  <div class="about-grid">
    <div class="about-photo">
      <Polaroid
        src="/uploads/photos/portrait.jpg"
        caption="just me"
        tilt={2}
        tape
      />
    </div>
    <div>
      <p>
        I'm Anoushka — a Computer Science student at The Hong Kong Polytechnic
        University, with a minor in Information Security. I make things at the
        intersection of craft and computation: zines and illustrations on one
        shelf, full-stack apps and machine-learning experiments on the other.
      </p>
      <p>
        I care about process, details, and work that feels human — whether
        that's a hand-painted fan piece or a React interface for real-time
        health data.
      </p>
      <p id="education">
        <strong style="font-family: var(--font-hand);">education</strong><br />
        B.Sc. (Hons) Computer Science, Minor in Information Security — The Hong
        Kong Polytechnic University
        <em style="display: block;">(Expected Graduation: June 2027)</em>
      </p>
    </div>
  </div>

  <div class="skills-wrap">
    <h2 class="section-heading" id="skills">skills</h2>
    <div class="skills">
      <div class="skill-box creative">
        <img
          class="skill-sticker"
          src={withBase('/uploads/stickers/sticker3-flower.png')}
          alt=""
          loading="lazy"
        />
        <h3>creative</h3>
        <ul>
          <li>illustration & fan art</li>
          <li>graphic design</li>
          <li>editorial layout</li>
          <li>visual branding</li>
          <li>UI/UX design</li>
          <li>Figma</li>
        </ul>
      </div>
      <div class="skill-box technical">
        <img
          class="skill-sticker"
          src={withBase('/uploads/stickers/sticker7-star-button.png')}
          alt=""
          loading="lazy"
        />
        <h3>technical</h3>
        <ul>
          <li>python</li>
          <li>java</li>
          <li>typescript</li>
          <li>react</li>
          <li>sql / oracle</li>
          <li>rest apis</li>
          <li>neural networks</li>
          <li>knime</li>
        </ul>
      </div>
    </div>
  </div>

  <section class="experience" id="experience">
    <h2 class="experience-heading">experience & roles</h2>

    <div class="exp-card">
      <h3>AI & Software Engineering Intern — TechPup Limited (Visual Earth)</h3>
      <p class="exp-meta">HK Science &amp; Technology Park (HKSTP) · Sep 2025 – Nov 2025</p>
      <ul>
        <li>Developed the front-end architecture of a mobile/web app in React, enabling real-time interaction with health data from a smart dog vest (IoT integration)</li>
        <li>Ran UI/UX research and iterated wireframes with designers, improving engagement for real-time monitoring</li>
        <li>Served as the primary technical liaison between the CEO and design team, translating business requirements into scalable UI components</li>
      </ul>
    </div>

    <div class="exp-card">
      <h3>Graphic Designer — Inscribe Journal, English Language Centre</h3>
      <p class="exp-meta">PolyU · Apr 2026 – Jun 2026</p>
      <ul>
        <li>Created banner artwork for published articles, aligning visuals with editorial themes</li>
        <li>Designed cohesive graphics that reflected the journal's identity across issues</li>
      </ul>
    </div>

    <div class="exp-card">
      <h3>Designer — Hall Editorial Committee</h3>
      <p class="exp-meta">PolyU Student Affairs Office · May 2026 – Jun 2026</p>
      <ul>
        <li>Designed layouts and visual elements for the PolyU Student Hall Yearbook 2025-26</li>
        <li>Worked with editors to translate content into visually appealing page designs</li>
      </ul>
    </div>

    <div class="exp-card">
      <h3>Event Assistant — Student Affairs Office</h3>
      <p class="exp-meta">PolyU · Aug 2025 – Oct 2025</p>
      <ul>
        <li>Managed registration systems and records for large-scale campus events using digital tools and spreadsheets</li>
      </ul>
    </div>

    <div class="exp-card">
      <h3>GDG at PolyU — Social Media Lead &amp; Assistant Technical Lead</h3>
      <p class="exp-meta">Google Developer Group · 2025 – 2026</p>
      <ul>
        <li>Support technical workshops and virtual events; manage digital infrastructure and troubleshooting</li>
      </ul>
    </div>

    <div class="exp-card">
      <h3>South Asian Society — Design &amp; Social Media Lead</h3>
      <p class="exp-meta">PolyU Student Affairs Office · 2025 – 2026</p>
      <ul>
        <li>Lead visual branding and digital engagement to promote cultural and community events</li>
      </ul>
    </div>

    <div class="exp-card">
      <h3>English Drama Club — Design Lead, Props &amp; Backstage Manager</h3>
      <p class="exp-meta">PolyU English Language Centre · 2024 – 2025</p>
      <ul>
        <li>Led a backstage team of 15 and coordinated with 13 actors for smooth production</li>
        <li>Designed promotional materials — Instagram content, t-shirts, tote bags</li>
      </ul>
    </div>

    <div class="exp-card">
      <h3>I-Peer Mentor — Non-Local Student Services</h3>
      <p class="exp-meta">PolyU · 2024 – 2026</p>
      <ul>
        <li>Mentored incoming international students and supported their academic and social integration</li>
      </ul>
    </div>
  </section>
</Base>
