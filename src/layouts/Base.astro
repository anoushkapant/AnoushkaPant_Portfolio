---
import '~/styles/global.css';
import Glitter from '~/components/Glitter.astro';
import { withBase } from '~/lib/paths';
import type { Props } from 'astro';

interface LayoutProps {
  title?: string;
  description?: string;
  clean?: boolean;
  typewriter?: boolean;
}
const { title = 'Anoushka — Portfolio', description = 'A scrapbook portfolio of creative and technical projects.', clean = false, typewriter = false } = Astro.props as LayoutProps;
const bodyClass = [clean ? 'clean' : null, typewriter ? 'typewriter' : null].filter(Boolean).join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={withBase('/uploads/stickers/sticker4-star.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Shantell+Sans:ital,wght@0,400;0,600;1,400&family=Special+Elite&family=Beth+Ellen&family=Alice&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class:list={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Glitter />
    <header class="site-nav">
      <a class="brand" href={withBase('/')}>
        <img
          class="brand-sticker"
          src={withBase('/uploads/stickers/sticker6-flower-pink.png')}
          alt=""
        />
        <span class="brand-name">anoushka</span>
      </a>
      <nav aria-label="Main">
        <a href={withBase('/#work')}>home</a>
        <a href={withBase('/about')}>about</a>
        <a href={withBase('/contact')}>contact</a>
        <a href={withBase('/fun')}>the sticker wall</a>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <span class="footer-links">
          <a href="https://github.com/anoushkapant" target="_blank" rel="noopener">github</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.instagram.com/artopotatoo/?hl=en" target="_blank" rel="noopener">instagram</a>
          <span aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/anoushka-pant-6b2b07292" target="_blank" rel="noopener">linkedin</a>
        </span>
        <span class="footer-year">anoushkap.pant@2026</span>
      </p>
    </footer>
  </body>
</html>
